    <script>
        function switchChar(charId) {
            const contents = document.querySelectorAll('.char-content');
            contents.forEach(content => content.classList.add('hidden'));

            const tabs = document.querySelectorAll('.char-tab');
            tabs.forEach(tab => {
                tab.classList.remove('opacity-100');
                tab.classList.add('opacity-50');
                
                const iconContainer = tab.querySelector('div');
                iconContainer.classList.remove('bg-gold', 'text-black', 'border-white', 'font-bold');
                iconContainer.classList.add('bg-black', 'text-gold', 'border-gold/50');
                
                const textSpan = tab.querySelector('span');
                textSpan.classList.remove('font-bold', 'text-gold-bright');
                textSpan.classList.add('font-medium', 'text-gray-300');
            });

            const selectedContent = document.getElementById('content-' + charId);
            if (selectedContent) selectedContent.classList.remove('hidden');

            const selectedTab = document.getElementById('tab-' + charId);
            if (selectedTab) {
                selectedTab.classList.remove('opacity-50');
                selectedTab.classList.add('opacity-100');
                
                const iconContainer = selectedTab.querySelector('div');
                iconContainer.classList.remove('bg-black', 'text-gold', 'border-gold/50');
                iconContainer.classList.add('bg-gold', 'text-black', 'border-white', 'font-bold');
                
                const textSpan = selectedTab.querySelector('span');
                textSpan.classList.remove('font-medium', 'text-gray-300');
                textSpan.classList.add('font-bold', 'text-gold-bright');
            }
        }
        
        function openModal(judul, tanggal, sinopsis) {
            document.getElementById('modal-title').innerText = judul;
            document.getElementById('modal-date').innerHTML = `<i class="far fa-calendar-alt"></i> ${tanggal}`;
            document.getElementById('modal-desc').innerText = sinopsis;
            
            const modal = document.getElementById('synopsis-modal');
            modal.classList.remove('hidden');
        }
        
        function closeModal() {
            document.getElementById('synopsis-modal').classList.add('hidden');
        }

        document.addEventListener('DOMContentLoaded', function() {
            const mobileBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileLinks = document.querySelectorAll('.mobile-link');
            const menuIcon = mobileBtn.querySelector('i');

            mobileBtn.addEventListener('click', function() {
                mobileMenu.classList.toggle('hidden');
                if (mobileMenu.classList.contains('hidden')) {
                    menuIcon.classList.remove('fa-times');
                    menuIcon.classList.add('fa-bars');
                } else {
                    menuIcon.classList.remove('fa-bars');
                    menuIcon.classList.add('fa-times');
                }
            });

            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                    menuIcon.classList.remove('fa-times');
                    menuIcon.classList.add('fa-bars');
                });
            });
        });
    </script>
