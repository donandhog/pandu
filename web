<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <!-- Meta tag wajib untuk tampilan optimal di HP -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Pandu Sriwedari - Wayang Orang</title>
    
    <!-- Tailwind CSS -->
    <script src="https://tailwindcss.com"></script>
    <!-- Font Awesome untuk Ikon -->
    <link href="https://cloudflare.com" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://googleapis.com" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: { DEFAULT: '#D4AF37', light: '#F3E5AB', dark: '#AA8C2C' },
                        cream: { DEFAULT: '#FDFBF7', dark: '#F5F0E6' },
                        brown: { DEFAULT: '#3B2F2F', light: '#5C4A4A' }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Sembunyikan scrollbar tapi tetap bisa di-scroll */
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        html { scroll-behavior: smooth; }
        body { color: #3B2F2F; }
        
        /* Gambar Latar Belakang Utama */
        .bg-utama {
            background-image: url('https://iili.io');
        }
    </style>
</head>
<body class="antialiased relative">

    <!-- LAPISAN BACKGROUND GLOBAL (Optimal untuk HP agar tidak lag saat scroll) -->
    <div class="fixed inset-0 w-full h-full bg-utama bg-cover bg-center z-[-2]"></div>
    
    <!-- Navbar (Tetap di atas) -->
    <nav class="fixed top-0 w-full bg-black/90 backdrop-blur-md z-50 text-gold-light border-b border-gold/20 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 md:h-20">
                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <img src="https://iconify.design" alt="Logo" class="w-8 h-8 md:w-10 md:h-10">
                    <div>
                        <h1 class="font-serif font-bold text-lg md:text-xl text-gold leading-tight">PANDU SRIWEDARI</h1>
                        <p class="text-[10px] md:text-xs text-gray-300">Panduan Digital Pengunjung</p>
                    </div>
                </div>
                
                <!-- Desktop Menu -->
                <div class="hidden lg:flex space-x-6 text-sm font-medium">
                    <a href="#beranda" class="hover:text-gold transition flex items-center gap-2 py-2"><i class="fas fa-home"></i> Beranda</a>
                    <a href="#jadwal" class="hover:text-gold transition flex items-center gap-2 py-2"><i class="fas fa-calendar-alt"></i> Jadwal</a>
                    <a href="#tokoh" class="hover:text-gold transition flex items-center gap-2 py-2"><i class="fas fa-users"></i> Tokoh & Cerita</a>
                    <a href="#tiket" class="hover:text-gold transition flex items-center gap-2 py-2"><i class="fas fa-ticket-alt"></i> Tiket</a>
                </div>

                <!-- Tombol Menu Mobile (Hamburger) -->
                <div class="lg:hidden">
                    <button id="mobile-menu-btn" class="text-gold hover:text-white p-2 focus:outline-none rounded-lg active:bg-gold/20 transition">
                        <i class="fas fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Dropdown Menu Mobile -->
        <div id="mobile-menu" class="hidden absolute w-full bg-black/95 backdrop-blur-lg border-b border-gold/20 shadow-2xl transition-all origin-top">
            <div class="px-4 pt-2 pb-6 space-y-1 text-base font-medium max-h-[80vh] overflow-y-auto">
                <a href="#beranda" class="mobile-link block text-gold-light hover:text-gold hover:bg-gold/10 px-3 py-3 rounded-xl transition"><i class="fas fa-home w-8 text-center"></i> Beranda</a>
                <a href="#jadwal" class="mobile-link block text-gold-light hover:text-gold hover:bg-gold/10 px-3 py-3 rounded-xl transition"><i class="fas fa-calendar-alt w-8 text-center"></i> Jadwal Pertunjukan</a>
                <a href="#tokoh" class="mobile-link block text-gold-light hover:text-gold hover:bg-gold/10 px-3 py-3 rounded-xl transition"><i class="fas fa-users w-8 text-center"></i> Tokoh & Cerita</a>
                <a href="#tiket" class="mobile-link block text-gold-light hover:text-gold hover:bg-gold/10 px-3 py-3 rounded-xl transition"><i class="fas fa-ticket-alt w-8 text-center"></i> Tiket & Kunjungan</a>
                <a href="#galeri" class="mobile-link block text-gold-light hover:text-gold hover:bg-gold/10 px-3 py-3 rounded-xl transition"><i class="fas fa-images w-8 text-center"></i> Galeri</a>
                <a href="#fasilitas" class="mobile-link block text-gold-light hover:text-gold hover:bg-gold/10 px-3 py-3 rounded-xl transition"><i class="fas fa-building w-8 text-center"></i> Fasilitas</a>
                <a href="#lakon" class="mobile-link block text-gold-light hover:text-gold hover:bg-gold/10 px-3 py-3 rounded-xl transition"><i class="fas fa-book-open w-8 text-center"></i> Lakon</a>
                <a href="#faq" class="mobile-link block text-gold-light hover:text-gold hover:bg-gold/10 px-3 py-3 rounded-xl transition"><i class="fas fa-question-circle w-8 text-center"></i> FAQ</a>
            </div>
        </div>
    </nav>

    <!-- Beranda -->
    <section id="beranda" class="relative pt-20 min-h-[90vh] md:min-h-screen flex items-center">
        <!-- Overlay Gelap Khusus Beranda -->
        <div class="absolute inset-0 z-0 bg-black/60 md:bg-black/70 backdrop-blur-[2px]"></div>

        <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 w-full text-white pt-10 pb-16">
            <div class="max-w-2xl mx-auto md:mx-0 text-center md:text-left">
                <h2 class="font-serif text-5xl sm:text-6xl md:text-7xl font-bold mb-4 md:mb-6 text-gold leading-[1.1] drop-shadow-lg">
                    Pertunjukan<br><span class="text-white text-3xl sm:text-4xl md:text-5xl">Wayang Orang Sriwedari</span>
                </h2>
                <p class="text-base sm:text-lg md:text-xl text-gray-200 mb-8 md:mb-12 font-medium drop-shadow">
                    Sajian seni pertunjukan tradisional yang memadukan drama, tari, karawitan, dan dialog berbahasa Jawa dengan nilai-nilai luhur budaya Nusantara.
                </p>
                
                <!-- Category Cards - Responsif di HP -->
                <div class="grid grid-cols-3 gap-2 md:gap-6 mb-8 md:mb-10">
                    <div class="bg-black/40 backdrop-blur-md border border-gold/30 rounded-2xl p-3 md:p-5 text-center active:scale-95 transition cursor-pointer">
                        <div class="w-10 h-10 md:w-14 md:h-14 mx-auto bg-gold/20 rounded-full flex items-center justify-center mb-2 md:mb-3">
                            <i class="fas fa-theater-masks text-gold text-xl md:text-3xl"></i>
                        </div>
                        <h3 class="font-semibold text-[11px] md:text-base leading-tight">Drama<br class="md:hidden"> Tradisional</h3>
                    </div>
                    <div class="bg-black/40 backdrop-blur-md border border-gold/30 rounded-2xl p-3 md:p-5 text-center active:scale-95 transition cursor-pointer">
                        <div class="w-10 h-10 md:w-14 md:h-14 mx-auto bg-gold/20 rounded-full flex items-center justify-center mb-2 md:mb-3">
                            <i class="fas fa-child text-gold text-xl md:text-3xl"></i>
                        </div>
                        <h3 class="font-semibold text-[11px] md:text-base leading-tight">Seni Tari<br class="md:hidden"> Klasik</h3>
                    </div>
                    <div class="bg-black/40 backdrop-blur-md border border-gold/30 rounded-2xl p-3 md:p-5 text-center active:scale-95 transition cursor-pointer">
                        <div class="w-10 h-10 md:w-14 md:h-14 mx-auto bg-gold/20 rounded-full flex items-center justify-center mb-2 md:mb-3">
                            <i class="fas fa-music text-gold text-xl md:text-3xl"></i>
                        </div>
                        <h3 class="font-semibold text-[11px] md:text-base leading-tight">Seni Musik<br class="md:hidden"> Tradisional</h3>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Script JavaScript untuk Tombol Hamburger Menu di HP -->
    <script>
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');

        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });

        // Menutup menu otomatis setelah link diklik
        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                menu.classList.add('hidden');
            });
        });
    </script>
</body>
</html>
