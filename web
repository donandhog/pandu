    <!-- KODE JAVASCRIPT: Menghidupkan tombol-tombol agar interaktif -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            /* --- 1. LOGIKA MENU MOBILE (HAMBURGER) --- */
            const mobileBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileLinks = document.querySelectorAll('.mobile-link');
            const menuIcon = mobileBtn.querySelector('i');

            // Buka/Tutup menu saat tombol garis tiga diklik
            mobileBtn.addEventListener('click', function() {
                mobileMenu.classList.toggle('hidden');
                
                // Ubah ikon dari Garis Tiga (Bars) menjadi Silang (X)
                if (mobileMenu.classList.contains('hidden')) {
                    menuIcon.classList.remove('fa-times');
                    menuIcon.classList.add('fa-bars');
                } else {
                    menuIcon.classList.remove('fa-bars');
                    menuIcon.classList.add('fa-times');
                }
            });

            // Tutup otomatis saat link di dalam menu diklik
            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                    menuIcon.classList.remove('fa-times');
                    menuIcon.classList.add('fa-bars');
                });
            });

            /* --- 2. LOGIKA TANYA JAWAB (FAQ ACCORDION) --- */
            const faqButtons = document.querySelectorAll('.faq-btn');
            
            faqButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Cari elemen jawaban tepat di bawah tombol yang diklik
                    const content = this.nextElementSibling;
                    const icon = this.querySelector('.fa-chevron-down');
                    
                    // Toggle class 'hidden' untuk memunculkan/menyembunyikan jawaban
                    content.classList.toggle('hidden');
                    
                    // Putar ikon panah 180 derajat
                    if(content.classList.contains('hidden')){
                         icon.style.transform = 'rotate(0deg)';
                    } else {
                         icon.style.transform = 'rotate(180deg)';
                    }
                });
            });
        });
    </script>
