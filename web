                    <!-- Gradient agar teks terbaca di HP -->
                    <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent md:hidden"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent to-white hidden md:block"></div>
                </div>
                <div class="md:w-3/5 p-6 md:p-10 flex flex-col justify-center relative z-10 -mt-6 md:mt-0 bg-white md:bg-transparent rounded-t-3xl md:rounded-none">
